"""
Multi-landmark form validation to prevent cheating
Ensures exercises are performed correctly by checking secondary landmarks
"""
from config.app_constants import LANDMARKS, VISIBILITY_THRESHOLD


class FormValidator:
    """
    Validates exercise form using multiple landmarks.

    Prevents cheating like:
    - Squat: lifting leg at squat angle without lowering body
    - Pushup: bending arms without lowering torso
    - Curl: moving elbow position instead of curling
    """

    # Minimum movement thresholds (in pixels)
    MIN_SQUAT_HIP_DROP = 40      # Hip must drop at least 40px
    MIN_PUSHUP_SHOULDER_DROP = 30  # Shoulder must drop at least 30px
    MIN_CURL_WRIST_RISE = 20    # Wrist must rise at least 20px

    def __init__(self):
        self.reset()

    def reset(self):
        """Reset all tracking state for new exercise/set"""
        self.baseline_positions = {}
        self.peak_positions = {}
        self.current_exercise = None
        self._rep_in_progress = False

    def start_rep(self):
        """Called when a rep starts (entering active state)"""
        self._rep_in_progress = True
        self.peak_positions = {}

    def update(self, exercise_type: str, landmarks, width: int, height: int):
        """
        Update with current frame landmarks.

        Args:
            exercise_type: 'squat', 'pushup', or 'curl'
            landmarks: MediaPipe pose landmarks
            width: frame width in pixels
            height: frame height in pixels
        """
        if landmarks is None:
            return

        # Reset if exercise changed
        if exercise_type != self.current_exercise:
            self.reset()
            self.current_exercise = exercise_type

        if exercise_type == 'squat':
            self._update_squat(landmarks, width, height)
        elif exercise_type == 'pushup':
            self._update_pushup(landmarks, width, height)
        elif exercise_type == 'curl':
            self._update_curl(landmarks, width, height)

    def _get_landmark_y(self, landmarks, landmark_name: str, height: int) -> float:
        """Get Y position of a landmark in pixels, or None if not visible"""
        idx = LANDMARKS.get(landmark_name)
        if idx is None:
            return None

        landmark = landmarks[idx]
        if landmark.visibility < VISIBILITY_THRESHOLD:
            return None

        return landmark.y * height

    def _get_avg_landmark_y(self, landmarks, left_name: str, right_name: str, height: int) -> float:
        """Get average Y of left and right landmarks"""
        left_y = self._get_landmark_y(landmarks, left_name, height)
        right_y = self._get_landmark_y(landmarks, right_name, height)

        if left_y is not None and right_y is not None:
            return (left_y + right_y) / 2
        elif left_y is not None:
            return left_y
        elif right_y is not None:
            return right_y
        return None

    def _update_squat(self, landmarks, width, height):
        """Track hip position for squat validation"""
        hip_y = self._get_avg_landmark_y(landmarks, 'LEFT_HIP', 'RIGHT_HIP', height)

        if hip_y is None:
            return

        # Track baseline (highest hip position = standing)
        # Lower Y value = higher in frame
        if 'hip_y' not in self.baseline_positions:
            self.baseline_positions['hip_y'] = hip_y
        else:
            # Update baseline only if hip is higher (smaller Y)
            self.baseline_positions['hip_y'] = min(self.baseline_positions['hip_y'], hip_y)

        # Track peak (lowest hip position = deepest squat)
        # Higher Y value = lower in frame
        if 'hip_y' not in self.peak_positions:
            self.peak_positions['hip_y'] = hip_y
        else:
            self.peak_positions['hip_y'] = max(self.peak_positions['hip_y'], hip_y)

    def _update_pushup(self, landmarks, width, height):
        """Track shoulder position for pushup validation"""
        shoulder_y = self._get_avg_landmark_y(landmarks, 'LEFT_SHOULDER', 'RIGHT_SHOULDER', height)

        if shoulder_y is None:
            return

        # Track baseline (highest shoulder = arms extended up)
        if 'shoulder_y' not in self.baseline_positions:
            self.baseline_positions['shoulder_y'] = shoulder_y
        else:
            self.baseline_positions['shoulder_y'] = min(self.baseline_positions['shoulder_y'], shoulder_y)

        # Track peak (lowest shoulder = arms bent down)
        if 'shoulder_y' not in self.peak_positions:
            self.peak_positions['shoulder_y'] = shoulder_y
        else:
            self.peak_positions['shoulder_y'] = max(self.peak_positions['shoulder_y'], shoulder_y)

    def _update_curl(self, landmarks, width, height):
        """Track wrist position for curl validation"""
        wrist_y = self._get_avg_landmark_y(landmarks, 'LEFT_WRIST', 'RIGHT_WRIST', height)

        if wrist_y is None:
            return

        # Track baseline (lowest wrist = arm extended down)
        # Higher Y = lower in frame
        if 'wrist_y' not in self.baseline_positions:
            self.baseline_positions['wrist_y'] = wrist_y
        else:
            self.baseline_positions['wrist_y'] = max(self.baseline_positions['wrist_y'], wrist_y)

        # Track peak (highest wrist = arm curled up)
        # Lower Y = higher in frame
        if 'wrist_y' not in self.peak_positions:
            self.peak_positions['wrist_y'] = wrist_y
        else:
            self.peak_positions['wrist_y'] = min(self.peak_positions['wrist_y'], wrist_y)

    def validate_rep(self, exercise_type: str) -> bool:
        """
        Validate that the rep was performed correctly.

        Args:
            exercise_type: 'squat', 'pushup', or 'curl'

        Returns:
            True if rep is valid, False if it appears to be cheating
        """
        if exercise_type == 'squat':
            is_valid = self._validate_squat()
        elif exercise_type == 'pushup':
            is_valid = self._validate_pushup()
        elif exercise_type == 'curl':
            is_valid = self._validate_curl()
        else:
            is_valid = True

        # Reset peak positions for next rep (keep baseline)
        self.peak_positions = {}
        self._rep_in_progress = False

        return is_valid

    def _validate_squat(self) -> bool:
        """
        Validate squat: hip must have dropped significantly.

        A real squat: hip Y increases (drops in frame) as you squat down.
        A fake leg-lift: hip Y stays the same while knee angle changes.
        """
        baseline = self.baseline_positions.get('hip_y')
        peak = self.peak_positions.get('hip_y')

        if baseline is None or peak is None:
            # Can't validate without data - allow it
            return True

        hip_drop = peak - baseline  # Positive if hip dropped (Y increased)

        return hip_drop >= self.MIN_SQUAT_HIP_DROP

    def _validate_pushup(self) -> bool:
        """
        Validate pushup: shoulders must have dropped.

        A real pushup: shoulder Y increases (drops) as you go down.
        A fake arm-bend: shoulder stays at same height.
        """
        baseline = self.baseline_positions.get('shoulder_y')
        peak = self.peak_positions.get('shoulder_y')

        if baseline is None or peak is None:
            return True

        shoulder_drop = peak - baseline

        return shoulder_drop >= self.MIN_PUSHUP_SHOULDER_DROP

    def _validate_curl(self) -> bool:
        """
        Validate curl: wrist must have risen.

        A real curl: wrist Y decreases (rises in frame) as you curl.
        Note: curls are less prone to cheating, so this is more lenient.
        """
        baseline = self.baseline_positions.get('wrist_y')
        peak = self.peak_positions.get('wrist_y')

        if baseline is None or peak is None:
            return True

        wrist_rise = baseline - peak  # Positive if wrist rose (Y decreased)

        return wrist_rise >= self.MIN_CURL_WRIST_RISE

    def get_validation_info(self) -> dict:
        """Get current validation tracking info (for debugging/display)"""
        return {
            'exercise': self.current_exercise,
            'baseline': self.baseline_positions.copy(),
            'peak': self.peak_positions.copy()
        }


if __name__ == "__main__":
    print("Testing FormValidator...")

    validator = FormValidator()

    # Simulate squat with proper hip drop
    class MockLandmark:
        def __init__(self, x, y, visibility=0.9):
            self.x = x
            self.y = y
            self.visibility = visibility

    # Create mock landmarks (indices 23=LEFT_HIP, 24=RIGHT_HIP)
    landmarks = [MockLandmark(0.5, 0.5) for _ in range(33)]

    # Standing position - hip at y=0.4 (higher in frame)
    landmarks[23] = MockLandmark(0.4, 0.4)
    landmarks[24] = MockLandmark(0.6, 0.4)
    validator.update('squat', landmarks, 640, 480)

    # Squatting position - hip at y=0.6 (lower in frame)
    landmarks[23] = MockLandmark(0.4, 0.6)
    landmarks[24] = MockLandmark(0.6, 0.6)
    validator.update('squat', landmarks, 640, 480)

    # Validate
    is_valid = validator.validate_rep('squat')
    print(f"  Squat with hip drop: {'VALID' if is_valid else 'INVALID'}")

    # Simulate fake squat (leg lift, no hip drop)
    validator.reset()
    landmarks[23] = MockLandmark(0.4, 0.4)
    landmarks[24] = MockLandmark(0.6, 0.4)
    validator.update('squat', landmarks, 640, 480)

    # Hip stays at same position
    validator.update('squat', landmarks, 640, 480)

    is_valid = validator.validate_rep('squat')
    print(f"  Squat without hip drop (cheat): {'VALID' if is_valid else 'INVALID'}")

    print("FormValidator test complete!")
